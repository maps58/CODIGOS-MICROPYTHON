#Práctica 1.3e
from machine import Pin,PWM
import time

sg90 = PWM(Pin(23, mode=Pin.OUT))
sg90.freq(50)

# (0.5ms/20ms) = 0.025 =2.5%
# (1.5ms/20ms) = 0.075 = 7.5%
# (2.4ms/20ms) = 0.12 = 12%

# 0.025*1024 = 25.6
# 0.075*1024=76.8
# 0.12*1024=122.8

while True:
    sg90.duty(26)
    time.sleep(1)
    sg90.duty(77)
    time.sleep(1)
    sg90.duty(123)
    time.sleep(1)
