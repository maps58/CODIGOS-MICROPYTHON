
from machine import Pin
import time

# Adjust pin numbers for your board (in this case ESP32)
led1 = Pin(14, Pin.OUT) # red
led2 = Pin(12, Pin.OUT) # green
  
btn1 = Pin(2, Pin.IN, Pin.PULL_UP)
btn2 = Pin(4, Pin.IN, Pin.PULL_UP)

while True:
    # Active-low logic: 0 means pressed, 1 means not pressed
    led1.value(1 if btn1.value() == 0 else 0)
    led2.value(1 if btn2.value() == 0 else 0)
    time.sleep_ms(20)
