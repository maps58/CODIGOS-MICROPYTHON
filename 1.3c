#Practica 1.3c
from machine import Pin, PWM
from time import sleep

# Configuración del PWM
pwm = PWM(Pin(2), freq=1000)

# Ciclos de trabajo
while True:
    for porcentaje in [25, 50, 75, 100]:

        valor = int((porcentaje / 100) * 1023)

        pwm.duty(valor)
        print("Duty Cycle:", porcentaje, "%")
        print("Valor PWM:", valor)
        sleep(2)
