from machine import Pin
import time

# Pin 2 is standard for most ESP32 dev boards
led = Pin(4, Pin.OUT) 

while True:
    led.value(0.5)  # Turn LED on
    print("Signal is HIGH")
    time.sleep_ms(250) # Wait 1 second
    led.value(0)  # Turn LED off
    print("Signal is LOW")
    time.sleep_ms(250) # Wait 1 second

